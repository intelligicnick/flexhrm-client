# Flex HRM — Frontend environment

# UI server port (dev: npm run dev, prod: npm start)
PORT=3000

# ── Local development ──────────────────────────────────────────────
BACKEND_URL=http://localhost:3001

# ── Production (set on the server; no rebuild needed for API URL) ───
# BACKEND_URL=http://127.0.0.1:3001
#   NestJS URL used by the Express /api proxy (same machine / private network).
#
# PUBLIC_API_URL=https://steelblue-hamster-881717.hostingersite.com
#   Required for static Hostinger deploys:
#     cp .env.production.example .env.production
#     npm run build
#   This writes dist/runtime-config.js so the browser calls your NestJS API directly.
#   Also set CORS_ORIGINS on the backend to your frontend origin.
#   If unset, the browser uses same-origin /api (needs Node server or nginx proxy).

# Optional: Gemini AI features
# GEMINI_API_KEY=your_key_here
