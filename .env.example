# Flex HRM — Frontend environment (optional for local dev)

# UI server port (dev: npm run dev, prod: npm start)
PORT=3000

# NestJS URL for the dev /api proxy (defaults to http://localhost:3001 if unset)
# BACKEND_URL=http://localhost:3001

# Production API URL (baked into the build on Hostinger — any of these names works)
# FLEXHRM_API_BASE=https://midnightblue-partridge-476451.hostingersite.com

# Public ID card QR verification URL (frontend route /employee/:idNo)
# VITE_ID_CARD_VERIFY_BASE_URL=https://greenyellow-woodpecker-750354.hostingersite.com/employee
